BIZOPS_ENVIRONMENT=development
BIZOPS_LOG_LEVEL=INFO

# Application runtime: non-superuser role, RLS enforced
BIZOPS_DATABASE_URL=postgresql+psycopg://bizops_app:bizops_app_dev@localhost:5432/bizops
# Migrations only: schema owner
BIZOPS_MIGRATION_DATABASE_URL=postgresql+psycopg://bizops_owner:bizops_owner_dev@localhost:5432/bizops